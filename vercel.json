{
  "framework": "nextjs",
  "buildCommand": "npx prisma generate && npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "regions": ["iad1"],
  "env": {
    "NEXT_PUBLIC_APP_URL": "https://rai-content-engine.vercel.app"
  },
  "functions": {
    "src/app/api/events/[campaignId]/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/process/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/research/competitors/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/automations/run-due/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/instagram/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/instagram/posts/[id]/publish/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/instagram",
      "schedule": "0 11 * * *"
    }
  ]
}
