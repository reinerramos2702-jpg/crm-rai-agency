# Base de datos (Supabase)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgmode=transaction"
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Redis (Upstash)
UPSTASH_REDIS_REST_URL="https://[tu-instancia].upstash.io"
UPSTASH_REDIS_REST_TOKEN="tu_token_aqui"

# Cloudflare R2
R2_ACCOUNT_ID="tu_account_id"
R2_ACCESS_KEY_ID="tu_access_key"
R2_SECRET_ACCESS_KEY="tu_secret_key"
R2_BUCKET="rai-content-engine"
R2_PUBLIC_URL="https://pub-[hash].r2.dev"

# Autenticación
JWT_SECRET="genera_uno_largo_aleatorio_aqui"
DEV_BYPASS_AUTH=true   # cambiar a false en producción
# Super admins de la plataforma (acceso cross-tenant). Emails separados por coma.
SUPER_ADMIN_EMAILS=

# Encriptación de API Keys (BYOK)
KEYS_ENCRYPTION_KEY="genera_con: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""

# Límites de costo
HARD_CAP_USD_PER_EXECUTION=50

# n8n (opcional al inicio)
N8N_WEBHOOK_URL="https://raiagency.app.n8n.cloud/webhook/rai-content"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Bases administradas por servidor para /api/inventory, separadas por path.delimiter.
# Cada workspace solo accede a <base>/<workspaceId>. Por defecto: ./inventory/<workspaceId>
# Usa ";" en Windows y ":" en Linux/macOS.
INVENTORY_ALLOWED_ROOTS="./inventory"

# Meta híbrido (Bloque 1, v3.0-master-prompt) — app compartida de RAI para el
# modo 'shared_app' (default de todo tenant nuevo). El modo 'own_app' usa las
# credenciales que cada tenant guarda vía PATCH /api/workspace/meta, no estas.
META_SHARED_APP_ID="tu_app_id_de_meta"
META_SHARED_APP_SECRET="tu_app_secret_de_meta"
META_OAUTH_REDIRECT_URI="http://localhost:3000/api/workspace/meta/oauth/callback"

# --- Publicación programada en Instagram (Corte B) ---
# 'simulated' (por defecto): no llama a Meta, marca los posts como publicados de prueba.
# 'live': publica de verdad por Graph API (exige imágenes con URL pública https y conexión Meta vigente).
IG_PUBLISH_MODE="simulated"
# Secreto del cron (/api/cron/publish y /api/automations/run-due). Generar con: openssl rand -hex 32
CRON_SECRET="genera_un_secreto_largo"

# --- Agente de voz (Retell AI) — docs/planning/VOZ-RETELL-PLAN.md ---
# 'simulated' (por defecto): cero gasto, nada sale a internet. 'live' exige RETELL_API_KEY.
VOICE_MODE="simulated"
RETELL_API_KEY=""
# Opcional: llave con la que se verifica la firma del webhook (por defecto, RETELL_API_KEY).
VOICE_WEBHOOK_SECRET=""
# Secreto de la herramienta buscar_conocimiento (>= 16 caracteres). Generar con: openssl rand -hex 24
VOICE_KB_SECRET=""
# voice_id por defecto (se elige en el panel de Retell; voz en español).
RETELL_VOICE_ID=""
# Dominio https público del CRM; el webhook queda en <URL>/api/voice/webhook?agent=<id>.
VOICE_PUBLIC_URL=""
# Modelo de lenguaje del agente y tope DURO mensual en USD (ningún ajuste del workspace lo supera).
RETELL_LLM_MODEL="gpt-4.1-mini"
VOICE_MONTHLY_CAP_USD="25"
# Supuestos de costo (ESTIMADOS, opcionales): VOICE_COST_ENGINE_PER_MIN, VOICE_COST_LLM_PER_MIN,
# VOICE_COST_TELEPHONY_PER_MIN, VOICE_COST_KB_PER_MIN, VOICE_COST_NUMBER_PER_MONTH, VOICE_COST_FORWARDING_PER_MIN.
