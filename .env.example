# Base de datos (Supabase)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgmode=transaction"
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Redis (Upstash)
UPSTASH_REDIS_REST_URL="https://[tu-instancia].upstash.io"
UPSTASH_REDIS_REST_TOKEN="tu_token_aqui"

# Cloudflare R2
R2_ACCOUNT_ID="tu_account_id"
R2_ACCESS_KEY_ID="tu_access_key"
R2_SECRET_ACCESS_KEY="tu_secret_key"
R2_BUCKET="rai-content-engine"
R2_PUBLIC_URL="https://pub-[hash].r2.dev"

# Autenticación
JWT_SECRET="genera_uno_largo_aleatorio_aqui"
DEV_BYPASS_AUTH=true   # cambiar a false en producción

# Encriptación de API Keys (BYOK)
KEYS_ENCRYPTION_KEY="genera_con: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""

# Límites de costo
HARD_CAP_USD_PER_EXECUTION=50

# n8n (opcional al inicio)
N8N_WEBHOOK_URL="https://raiagency.app.n8n.cloud/webhook/rai-content"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Meta híbrido (Bloque 1, v3.0-master-prompt) — app compartida de RAI para el
# modo 'shared_app' (default de todo tenant nuevo). El modo 'own_app' usa las
# credenciales que cada tenant guarda vía PATCH /api/workspace/meta, no estas.
META_SHARED_APP_ID="tu_app_id_de_meta"
META_SHARED_APP_SECRET="tu_app_secret_de_meta"
META_OAUTH_REDIRECT_URI="http://localhost:3000/api/workspace/meta/oauth/callback"
